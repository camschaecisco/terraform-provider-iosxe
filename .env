# IOS XE Test Environment Configuration

# Global credentials
IOSXE_USERNAME=admin
IOSXE_PASSWORD=cisco!123

# Device to test (set one at a time)
# Router:
# IOSXE_HOST=10.81.239.57

# Switch:
# IOSXE_HOST=10.81.239.60

# 1712 router:
#IOSXE_HOST=10.81.239.10

IOSXE_1715_ROUTER_HOST=10.81.239.57
IOSXE_1715_SWITCH_HOST=10.81.239.60
IOSXE_1712_ROUTER_HOST=10.81.239.10
# IOSXE_1712_SWITCH_HOST: # The IP or FQDN of the switch running IOS-XE 17.12.x


# Bypass proxy for test devices
NO_PROXY=localhost,.gselab.cisco.com,.cisco.com,10.226.13.11,9.1.0.0/16,10.81.0.0/16,9.1.4.55,10.81.239.57,10.81.239.60
